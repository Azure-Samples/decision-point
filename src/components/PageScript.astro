---
// The page script (one of the page's few scripts): motion flag, scroll reveal, flip cards, the incident loops' gate,
// the pending controls' click guard, the dot field's lens, the hero video, the
// header's section highlight and the game's sounds. (The header's scroll surface lives in SiteHeader.astro's script.)
// Without JS nothing is hidden: the reveal is only armed here, and the flip cards fall back to both faces' text.
---

<script>
  const root = document.documentElement;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const motionOK = () => !reduce.matches;
  const syncMotion = () => root.classList.toggle('motion', motionOK());
  syncMotion();

  /* ---------- Scroll reveal: lists and headers. Nothing on screen at load, without JS, or under reduced motion is hidden. ---------- */
  let io: IntersectionObserver | null = null;
  const reveal = (g: Element) => {
    g.classList.add('rv-in');
    io?.unobserve(g);
  };
  const armReveal = () => {
    io?.disconnect();
    io = null;
    const groups = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
    groups.forEach((g) => g.classList.add('rv-in'));
    if (!motionOK()) return;
    io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && reveal(e.target)), { rootMargin: '0px 0px -10% 0px' });
    groups.forEach((g) => {
      if (g.offsetParent === null) return;
      [...g.querySelectorAll<HTMLElement>('.rv-h, .rv')]
        .filter((u) => u.offsetParent !== null)
        .forEach((u, i) => u.style.setProperty('--i', String(Math.min(i, 9))));
      if (g.getBoundingClientRect().top < window.innerHeight) return;
      g.classList.remove('rv-in');
      io!.observe(g);
    });
  };
  armReveal();
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
    const id = a?.getAttribute('href');
    const t = id && id.length > 1 ? document.querySelector(id) : null;
    if (t?.matches('[data-reveal]')) reveal(t);
  });

  /* ---------- Flip cards: focus follows the face that's showing; the hidden face is inert ---------- */
  document.querySelectorAll<HTMLButtonElement>('[data-flip]').forEach((b) =>
    b.addEventListener('click', () => {
      const card = b.closest('.flip');
      if (!card) return;
      const flipped = card.classList.toggle('flipped');
      const [front, back] = card.querySelectorAll<HTMLElement>('.face');
      front.inert = flipped;
      back.inert = !flipped;
      front.querySelector('[data-flip]')?.setAttribute('aria-expanded', String(flipped));
      (flipped ? back.querySelector<HTMLElement>('.lesson') : front.querySelector<HTMLElement>('[data-flip]'))?.focus({ preventScroll: true });
    }),
  );

  /* ---------- Incident loops: CSS animations that run only while the set is in view, the tab is visible and motion is
     allowed. Under reduced motion html.motion is off, so no animation is ever created. No pause control: an accepted
     WCAG 2.2.2 exception. ---------- */
  const illos = document.getElementById('illos');
  if (illos) {
    let illoSeen = false;
    const syncIllos = () => illos.classList.toggle('illo-live', motionOK() && illoSeen && !document.hidden);
    new IntersectionObserver((es) => es.forEach((e) => { illoSeen = e.isIntersecting; syncIllos(); })).observe(illos);
    document.addEventListener('visibilitychange', syncIllos);
    reduce.addEventListener('change', syncIllos);
  }

  /* ---------- Pending controls (preview only; restore inactive styling before launch). Every control whose URL is
     still a {{placeholder}} renders live (href="#", data-pending), with its full hover, focus and press; clicking it
     does nothing. ---------- */
  document.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a[data-pending]')) e.preventDefault();
  });

  /* ---------- The dot field's lens (DotField.astro): with a mouse and motion allowed, a circle of brighter dots eases
     toward the pointer and fades out when it leaves. Two CSS variables per frame, written only while it moves. ---------- */
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  document.querySelectorAll<HTMLElement>('.dx > .dots-lit').forEach((lit) => {
    const host = lit.parentElement!.parentElement!;
    let x = 0, y = 0, tx = 0, ty = 0, raf = 0;
    const step = () => {
      x += (tx - x) * 0.12;
      y += (ty - y) * 0.12;
      lit.style.setProperty('--gx', `${x.toFixed(1)}px`);
      lit.style.setProperty('--gy', `${y.toFixed(1)}px`);
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(step) : 0;
    };
    host.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || !fine.matches || !motionOK()) return;
      const r = host.getBoundingClientRect();
      tx = e.clientX - r.left;
      ty = e.clientY - r.top;
      if (!lit.classList.contains('on')) {
        x = tx;
        y = ty;
        lit.classList.add('on');
      }
      raf ||= requestAnimationFrame(step);
    }, { passive: true });
    host.addEventListener('pointerleave', () => lit.classList.remove('on'));
  });

  /* ---------- The section in view: the header link whose section crosses a line 35% down the viewport gets
     aria-current; between linked sections none does. Rects read once per frame while scrolling. Not motion, so it runs
     under reduced motion too. ---------- */
  const spy = [...document.querySelectorAll<HTMLAnchorElement>('.site-header .nav a[href^="#"]')]
    .map((a) => ({ a, s: document.querySelector<HTMLElement>(a.getAttribute('href')!) }))
    .filter((x): x is { a: HTMLAnchorElement; s: HTMLElement } => !!x.s);
  let spyQueued = false;
  const spyUpdate = () => {
    spyQueued = false;
    const line = window.innerHeight * 0.35;
    spy.forEach(({ a, s }) => {
      const r = s.getBoundingClientRect();
      const on = r.top <= line && r.bottom > line;
      if (on) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    });
  };
  if (spy.length) {
    const queue = () => {
      if (spyQueued) return;
      spyQueued = true;
      requestAnimationFrame(spyUpdate);
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue, { passive: true });
    spyUpdate();
  }

  /* ---------- The game's sounds. The game's own files (public/sounds/), played the
     way the game plays them: its ambient loop, a whoosh on hovering a link or button, and clicks matched to the game's
     (starting the game, choosing a section, flipping an incident, everything else). Nothing loads or plays before the
     first click or key press (browsers allow no sound before one); the header's switch mutes it all and is remembered on
     this browser; a hidden tab is silent. ---------- */
  const sndBtn = document.querySelector<HTMLButtonElement>('[data-sound]');
  if (sndBtn && 'AudioContext' in window) {
    const dir = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/sounds/`;
    const SFX = {
      ambient: 'azure_ambient.ogg',
      click: 'ui_azure_main_click.mp3',
      startClick: 'ui_azure_start_click.mp3',
      optionClick: 'ui_azure_option_click.mp3',
      clickIncident: 'ui_click_incident.mp3',
      hover: 'ui_azure_whoosh_icon_move.mp3',
      buttonHover: 'ui_azure_whoosh_icon_move_02.mp3',
    };
    type Sfx = keyof typeof SFX | 'clickIncidentRev';
    const MUTE_KEY = 'dp_sound_muted';
    const bufs: Partial<Record<Sfx, AudioBuffer>> = {};
    let ctx: AudioContext | null = null, master: GainNode | null = null, ambient: AudioBufferSourceNode | null = null;
    let loading: Promise<void> | null = null, lastHover = 0, muted = false;
    try {
      muted = localStorage.getItem(MUTE_KEY) === 'true';
    } catch {
      /* storage blocked: sound starts on */
    }

    const load = () =>
      (loading ??= (async () => {
        const ac = (ctx = new AudioContext());
        master = ac.createGain();
        master.gain.value = muted ? 0 : 1;
        master.connect(ac.destination);
        await Promise.all(
          Object.entries(SFX).map(async ([k, file]) => {
            try {
              bufs[k as Sfx] = await ac.decodeAudioData(await (await fetch(dir + file)).arrayBuffer());
            } catch {
              /* a file that fails to load stays silent */
            }
          }),
        );
        // Closing a flipped card plays the incident click backwards
        const fwd = bufs.clickIncident;
        if (fwd) {
          const rev = ac.createBuffer(fwd.numberOfChannels, fwd.length, fwd.sampleRate);
          for (let c = 0; c < fwd.numberOfChannels; c++) rev.getChannelData(c).set(fwd.getChannelData(c).slice().reverse());
          bufs.clickIncidentRev = rev;
        }
      })());

    const play = (name: Sfx, vol = 1, { rate = 1, offset = 0, dur = 0 } = {}) => {
      const buf = bufs[name];
      if (!ctx || !master || muted || !buf) return;
      const src = ctx.createBufferSource(), g = ctx.createGain(), t = ctx.currentTime;
      src.buffer = buf;
      src.playbackRate.value = rate;
      g.gain.value = vol;
      src.connect(g).connect(master);
      if (dur) {
        g.gain.setValueAtTime(vol, t + Math.max(0, dur - 0.04));
        g.gain.linearRampToValueAtTime(0, t + dur);
        src.start(t, offset, dur * rate);
      } else src.start(t, offset);
    };

    // The flip sounds fit the flip itself, timed from the page's own tokens: opening (--dur-flip) plays the whole click
    // sped up to fit, closing (--dur-emph) the reversed click from past its quiet lead-in. Under reduced motion the flip
    // is instant (the tokens are 0), so it gets the short option click instead.
    const seconds = (v: string) => {
      const raw = getComputedStyle(root).getPropertyValue(v).trim(), n = parseFloat(raw) || 0;
      return raw.endsWith('ms') ? n / 1000 : n;
    };
    const playFlip = (closing: boolean) => {
      const fwd = bufs.clickIncident, dur = seconds(closing ? '--dur-emph' : '--dur-flip');
      if (!fwd || dur <= 0) return play('optionClick', 0.6);
      if (!closing) return play('clickIncident', 1, { rate: fwd.duration / dur, dur });
      const rate = 2.2;
      play('clickIncidentRev', 1, { rate, offset: Math.max(0, fwd.duration - dur * rate), dur });
    };

    // The ambient loop fades in over 2s at a quarter volume, once; it ducks out while the hero video is heard
    const AMBIENT = 0.25;
    let ambientGain: GainNode | null = null, videoHeard = false;
    const wake = async () => {
      await load();
      if (!ctx || !master) return;
      if (ctx.state === 'suspended') await ctx.resume();
      if (ambient || !bufs.ambient) return;
      const src = ctx.createBufferSource(), g = ctx.createGain();
      src.buffer = bufs.ambient;
      src.loop = true;
      g.gain.setValueAtTime(0, ctx.currentTime);
      g.gain.linearRampToValueAtTime(videoHeard ? 0 : AMBIENT, ctx.currentTime + 2);
      src.connect(g).connect(master);
      src.start();
      ambient = src;
      ambientGain = g;
    };
    window.addEventListener('dp:video-sound', (e) => {
      videoHeard = (e as CustomEvent<boolean>).detail;
      if (!ctx || !ambientGain) return;
      ambientGain.gain.cancelScheduledValues(ctx.currentTime);
      ambientGain.gain.setTargetAtTime(videoHeard ? 0 : AMBIENT, ctx.currentTime, 0.25);
    });

    const setMuted = (m: boolean) => {
      muted = m;
      try {
        localStorage.setItem(MUTE_KEY, String(m));
      } catch {
        /* storage blocked: the choice lasts for this page view */
      }
      if (ctx && master) master.gain.setTargetAtTime(m ? 0 : 1, ctx.currentTime, 0.05);
      // Muting the page mutes the hero video too
      if (m) window.dispatchEvent(new Event('dp:site-muted'));
      sndBtn.setAttribute('aria-pressed', String(m));
      // Analytics names the click by what it just did; this runs before the click reaches Analytics' document listener
      sndBtn.dataset.cta = m ? 'mute' : 'unmute';
    };

    sndBtn.hidden = false;
    sndBtn.setAttribute('aria-pressed', String(muted));
    sndBtn.addEventListener('click', async () => {
      setMuted(!muted);
      await wake();
      if (!muted) play('optionClick');
    });
    document.addEventListener('pointerdown', wake, { once: true, capture: true });
    document.addEventListener('keydown', wake, { once: true, capture: true });
    // Hovers: mouse only, never more than one every 90ms
    document.addEventListener('pointerover', (e) => {
      if (e.pointerType !== 'mouse') return;
      const t = (e.target as Element).closest('a, button');
      if (!t || t.contains(e.relatedTarget as Node | null) || t === sndBtn) return;
      const now = performance.now();
      if (now - lastHover < 90) return;
      lastHover = now;
      play(t.matches('.btn, button') ? 'buttonHover' : 'hover', 0.6);
    });
    // Clicks, matched to the game's own: starting the game, choosing a section, flipping an incident, everything else
    document.addEventListener('click', (e) => {
      const t = (e.target as Element).closest<HTMLElement>('a, button');
      if (!t || t === sndBtn) return;
      if ((t.dataset.cta ?? '').startsWith('launch')) play('startClick');
      else if (t.closest('.site-header .nav')) play('optionClick');
      else if (t.matches('[data-flip]')) playFlip(!!t.closest('.flip')?.classList.contains('flipped'));
      else play('click');
    }, true);
    document.addEventListener('visibilitychange', () => {
      if (ctx) document.hidden ? ctx.suspend() : ctx.resume();
    });
  }

  /* ---------- Hero video: the client's game preview in its player (Hero.astro). It plays muted on a loop (no browser
     allows sound before a click) unless the visitor prefers reduced motion, and only while on screen in a visible tab;
     a pause from the player holds it until they press play. The first time its sound goes on it starts from the top.
     While it's heard the page's ambient loop ducks out, and the header's switch mutes it with everything else. ---------- */
  const vid = document.getElementById('hero-video') as HTMLVideoElement | null;
  if (vid) {
    const playBtn = document.getElementById('hero-video-play');
    const muteBtn = document.getElementById('hero-video-mute');
    let held = !motionOK(), onscreen = true, heard = false, ours = false;
    vid.controls = false;

    // Analytics reads data-cta as the click reaches the document, before the video reports the change, so each name is
    // the action the control will take next
    const name = () => {
      if (playBtn) playBtn.dataset.cta = vid.paused ? 'video-play' : 'video-pause';
      if (muteBtn) muteBtn.dataset.cta = vid.muted ? 'video-sound-on' : 'video-sound-off';
    };
    const run = () => {
      const want = !held && onscreen && !document.hidden;
      if (want && vid.paused) vid.play().catch(() => {});
      else if (!want && !vid.paused) {
        ours = true;
        vid.pause();
      }
    };
    // The sound system listens for this to duck its ambient loop
    const announce = () =>
      window.dispatchEvent(new CustomEvent('dp:video-sound', { detail: !vid.muted && vid.volume > 0 && !vid.paused }));

    vid.addEventListener('play', () => {
      held = false;
      name();
      announce();
    });
    vid.addEventListener('pause', () => {
      // A pause we didn't make came from the visitor: hold it
      if (ours) ours = false;
      else held = true;
      name();
      announce();
    });
    vid.addEventListener('volumechange', () => {
      if (!vid.muted && !heard) {
        heard = true;
        vid.currentTime = 0;
        held = false;
        run();
      }
      name();
      announce();
    });
    window.addEventListener('dp:site-muted', () => {
      vid.muted = true;
    });

    new IntersectionObserver((es) => es.forEach((e) => { onscreen = e.isIntersecting; run(); }), { threshold: 0.2 }).observe(vid);
    document.addEventListener('visibilitychange', run);
    reduce.addEventListener('change', () => {
      syncMotion();
      armReveal();
      held = !motionOK();
      run();
    });
    name();
    run();
  } else {
    reduce.addEventListener('change', () => { syncMotion(); armReveal(); });
  }
</script>
