---
import { footer, assets } from '../content/copy';
import { links } from '../content/links';
import { ANALYTICS_UI } from '../lib/inline';
---

<footer class="site-footer">
  <div class="wrap row">
    <p>{footer.line}</p>
    <ul>
      {
        footer.links.map((l) => (
          <li>
            <a class="text-link" href={links[l.link]} target="_blank" rel="noopener">
              {l.label}
              <span class="sr-only"> {assets.newTab}</span>
            </a>
          </li>
        ))
      }
      {ANALYTICS_UI && <li><button type="button" class="text-link" data-consent-open>{footer.cookies}</button></li>}
    </ul>
    {footer.legal && <p class="legal">{footer.legal}</p>}
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-10) var(--space-12);
    border-top: 1px solid var(--color-line);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4) var(--space-8);
  }

  /* The link strip sits a step below the body size, with room between links */
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-8);
    list-style: none;
    padding: 0;
    font-size: var(--text-sm);
  }

  li {
    display: flex;
    align-items: center;
    min-height: 1.5rem;
  }

  button.text-link {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  .legal {
    flex-basis: 100%;
  }
</style>
