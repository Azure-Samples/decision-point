---
import Icon from './Icon.astro';
import { footer, assets } from '../content/copy';
import { links, type LinkKey } from '../content/links';
import { hrefFor, isFilled, isResolved, looksLive, ANALYTICS_UI } from '../lib/inline';
---

<footer class="site-footer">
  <div class="wrap row">
    <p>{footer.line}</p>
    <ul>
      {
        footer.links.map((l) => {
          const href = links[l.link as LinkKey];
          return (
            <li>
              {/* Preview only: pending links render live; restore inactive styling before launch */}
              {looksLive(href) ? (
                <a class="text-link" href={hrefFor(href)} target={isResolved(href) ? '_blank' : undefined} rel={isResolved(href) ? 'noopener' : undefined} data-pending={isResolved(href) ? undefined : ''}>
                  {l.label}
                  {isResolved(href) && <span class="sr-only"> {assets.newTab}</span>}
                </a>
              ) : (
                <span class="pend" role="link" aria-disabled="true">{l.label}<Icon name="clock" size={12} /></span>
              )}
            </li>
          );
        })
      }
      {ANALYTICS_UI && <li><button type="button" class="text-link" data-consent-open>{footer.cookies}</button></li>}
    </ul>
    {isFilled(footer.legal) && <p class="legal">{footer.legal}</p>}
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-10) var(--space-12);
    border-top: 1px solid var(--color-line);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4) var(--space-8);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    list-style: none;
    padding: 0;
  }

  li {
    display: flex;
    align-items: center;
    min-height: 1.5rem;
  }

  button.text-link {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  .legal {
    flex-basis: 100%;
  }
</style>
