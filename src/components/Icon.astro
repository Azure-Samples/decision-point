---
import { iconBody, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

// Decorative only: every icon sits beside its words, so it stays hidden from assistive tech
const { name, size = 20, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['icon', className]}
  style={`--icon-size: ${size / 16}rem`}
  aria-hidden="true"
  focusable="false"
  set:html={iconBody(name)}
/>

<style>
  .icon {
    width: var(--icon-size);
    height: var(--icon-size);
    flex: none;
  }
</style>
