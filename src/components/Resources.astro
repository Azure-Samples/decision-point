---
import Icon from './Icon.astro';
import DotField from './DotField.astro';
import { resources, assets } from '../content/copy';
import { links } from '../content/links';
import { titleParts } from '../lib/inline';
import type { IconName } from '../lib/icons';

// Three unframed columns, each headed by its hued chip. On hover a tile lifts, takes a faint wash of its column's hue,
// underlines its title and leans its arrow up and out.
const colIcons: IconName[] = ['book', 'tools', 'users'];
const colHues = ['--hue-blue', '--hue-amber', '--hue-violet'];
const [setup, payoff] = titleParts(resources.title);
---

<section class="section centred utility-pad band" id="resources" data-reveal aria-labelledby="resources-title">
  <DotField light={['topglow']} />
  <div class="wrap">
    <h2 class="title rv-h" id="resources-title">
      <span class="t-quiet">{setup}</span> {payoff}
    </h2>
    <div class="cols">
      {
        resources.columns.map((col, c) => (
          <div class="col rv" style={`--chip-hue: var(${colHues[c]})`}>
            <h3><span class="icon-chip hued" aria-hidden="true"><Icon name={colIcons[c]} size={20} /></span>{col.heading}</h3>
            <ul>
              {col.items.map((item) => (
                <li>
                  <a class="tile" href={links[item.link]} target="_blank" rel="noopener" data-cta={`resource-${item.link}`}>
                    <span class="t">
                      {item.label}
                      {'tail' in item && <> <span class="tail">{item.tail}</span></>}
                      <span class="sr-only"> {assets.newTab}</span>
                    </span>
                    <Icon name="arrow-up-right" size={20} class="go" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  #resources {
    overflow: clip;
  }

  /* "Developer Resources" reads on one line where it fits */
  #resources-title {
    max-width: none;
  }

  #resources-title .t-quiet {
    display: inline;
  }

  @media (min-width: 64.01rem) {
    #resources-title {
      white-space: nowrap;
    }
  }

  /* Three unframed columns on one grid, with no dividers; rows are shared across them (subgrid), so every tile lines
     up */
  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: auto repeat(3, 1fr);
    gap: 0;
    margin-top: var(--space-14);
    text-align: left;
  }

  .col {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: var(--space-3);
    padding-inline: var(--space-6);
  }

  .col:first-child {
    padding-left: 0;
  }

  .col:last-child {
    padding-right: 0;
  }

  .col ul {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    row-gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .col li {
    display: grid;
  }

  h3 {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-2);
    font-size: 1.0625rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  /* Tiles: empty, with a faint outline */
  .tile {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: 100%;
    min-height: 4.5rem;
    padding: 1rem var(--space-5);
    border: 1px solid rgb(246 247 249 / 0.08);
    border-radius: var(--radius-sm);
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    color: var(--color-ink);
    text-decoration: none;
    transition:
      background-color var(--dur-state) var(--ease-state),
      border-color var(--dur-state) var(--ease-state),
      translate var(--dur-state) var(--ease-out);
  }

  .t {
    display: block;
    font-weight: var(--weight-semibold);
    line-height: 1.3;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    text-decoration-color: transparent;
    transition: text-decoration-color var(--dur-state) var(--ease-state);
  }

  .tail {
    white-space: nowrap;
  }

  /* The arrows rest grey and turn white on hover */
  .tile :global(.go) {
    color: var(--color-muted);
    transition:
      color var(--dur-state) var(--ease-state),
      translate var(--dur-state) var(--ease-out);
  }

  /* Hover: a faint wash of the column's hue from the top left (the column chip's --chip-hue: Learn blue, Build amber,
     Community violet), and the title's underline in the same hue */
  .tile:is(:hover, :focus-visible) {
    background: radial-gradient(130% 140% at 0% 0%, color-mix(in srgb, var(--chip-hue) 16%, transparent), transparent 62%);
    border-color: color-mix(in srgb, var(--chip-hue) 28%, transparent);
  }

  .tile:is(:hover, :focus-visible) :global(.go) {
    color: var(--color-ink);
  }

  .tile:is(:hover, :focus-visible) .t {
    text-decoration-color: var(--chip-hue);
  }

  @media (prefers-reduced-motion: no-preference) {
    .tile:is(:hover, :focus-visible) {
      translate: 0 calc(var(--move-nudge) * -1);
    }

    .tile:is(:hover, :focus-visible) :global(.go) {
      translate: 2px -2px;
    }
  }

  @media (max-width: 64rem) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      row-gap: var(--space-10);
      max-width: 34rem;
      margin-inline: auto;
    }

    .col,
    .col ul {
      grid-row: auto;
      grid-template-rows: none;
    }

    .col {
      padding-inline: 0;
    }

    /* Stacked, the columns sit further apart */
    .col + .col {
      padding-top: var(--space-10);
    }
  }
</style>
