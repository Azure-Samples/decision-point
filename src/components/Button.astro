---
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';
import { isResolved, PREVIEW_PENDING_LIVE } from '../lib/inline';
import { assets } from '../content/copy';

interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  size?: 'md' | 'lg';
  /** Analytics hook: every CTA carries data-cta. */
  cta: string;
  icon?: IconName;
}

const { href, variant = 'ghost', size = 'md', cta, icon } = Astro.props;
const external = isResolved(href);
const internal = href.startsWith('#');
// PENDING: for the preview, a control with no URL yet renders live (href="#", data-pending; the page script cancels
// the click). Restore inactive styling before launch.
const previewLive = !external && !internal && PREVIEW_PENDING_LIVE;
const classes = ['btn', `btn-${variant}`, size === 'lg' && 'btn-lg'];
---

{
  external || internal || previewLive ? (
    <a class:list={classes} href={previewLive ? '#' : href} data-cta={cta} data-pending={previewLive ? '' : undefined} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
      {icon && <Icon name={icon} size={16} />}
      <slot />
      {external && <span class="sr-only"> {assets.newTab}</span>}
    </a>
  ) : (
    /* The target doesn't exist yet ({{placeholder}}): never a dead link */
    <span class:list={[...classes, 'is-pending']} role="link" aria-disabled="true" data-cta={cta}>
      {icon && <Icon name={icon} size={16} />}
      <slot />
      {/* The pending cue (one language page-wide): a solid edge and a small clock, never a faded or dashed control */}
      <Icon name="clock" size={14} class="pend-mark" />
    </span>
  )
}

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    padding: 0 var(--space-6);
    border-radius: var(--radius-sm);
    font: var(--weight-semibold) var(--text-sm) / 1.2 var(--font-sans);
    text-align: center;
    text-wrap: balance;
    text-decoration: none;
    /* Labels wrap rather than overflow at 320px and under the WCAG 1.4.12 spacing override */
    padding-block: var(--space-2);
    transition:
      background-color var(--dur-state) var(--ease-state),
      border-color var(--dur-state) var(--ease-state),
      transform var(--dur-press) var(--ease-state);
  }

  a.btn:active {
    transform: scale(0.97);
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-on-accent);
    box-shadow: var(--shadow-cta);
  }

  a.btn-primary:hover {
    background: var(--color-accent-hover);
  }

  a.btn-primary:active {
    background: var(--color-accent-press);
  }

  .btn-ghost {
    background: transparent;
    color: var(--color-ink);
    border: 1.5px solid var(--color-control-border);
  }

  a.btn-ghost:hover {
    background: var(--color-hover-wash);
  }

  /* The closing call to action's size, one step up */
  .btn-lg {
    min-height: 3.75rem;
    padding-inline: var(--space-8);
    font-size: 1rem;
  }

  /* Pending keeps the control's weight (a primary stays the strongest thing on screen); the cue is a solid inner edge
     and a clock, never dashed or dotted, and nothing changes on hover */
  .is-pending {
    cursor: not-allowed;
  }

  .btn-primary.is-pending {
    box-shadow:
      var(--shadow-cta),
      inset 0 0 0 1px var(--color-accent),
      inset 0 0 0 2px var(--pending-inset);
  }

  .btn-ghost.is-pending {
    border-color: var(--pending-border);
  }

  .is-pending :global(.pend-mark) {
    margin-left: var(--space-1);
    opacity: 0.85;
  }

  @media (max-width: 40rem) {
    .btn {
      width: 100%;
    }

    /* Phones: the large button keeps its height but not its side padding, so its label stays on one line */
    .btn-lg {
      padding-inline: var(--space-4);
    }
  }
</style>
