---
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';
import { assets } from '../content/copy';

interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  /** Analytics hook: every CTA carries data-cta (its names are in src/lib/cta.ts). */
  cta: string;
  icon?: IconName;
}

const { href, variant = 'ghost', cta, icon } = Astro.props;
// In-page links (#…) stay in the tab; every other link opens in a new one
const external = !href.startsWith('#');
---

<a class:list={['btn', `btn-${variant}`]} href={href} data-cta={cta} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
  {icon && <Icon name={icon} size={16} />}
  <slot />
  {external && <span class="sr-only"> {assets.newTab}</span>}
</a>

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    padding: 0 var(--space-6);
    border-radius: var(--radius-sm);
    font: var(--weight-semibold) var(--text-sm) / 1.2 var(--font-sans);
    text-align: center;
    text-wrap: balance;
    text-decoration: none;
    /* Labels wrap rather than overflow at 320px and under the WCAG 1.4.12 spacing override */
    padding-block: var(--space-2);
    transition:
      background-color var(--dur-state) var(--ease-state),
      border-color var(--dur-state) var(--ease-state),
      transform var(--dur-press) var(--ease-state);
  }

  .btn:active {
    transform: scale(0.97);
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-on-accent);
    box-shadow: var(--shadow-cta);
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
  }

  .btn-primary:active {
    background: var(--color-accent-press);
  }

  .btn-ghost {
    background: transparent;
    color: var(--color-ink);
    border: 1.5px solid var(--color-control-border);
  }

  .btn-ghost:hover {
    background: var(--color-hover-wash);
  }

  @media (max-width: 40rem) {
    .btn {
      width: 100%;
    }
  }
</style>
